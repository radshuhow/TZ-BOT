# Токен вашего бота, полученный от @BotFather
BOT_TOKEN=123456:ABC-DEF1234567890

# Строка подключения к вашей MongoDB
# Пример: mongodb://user:password@localhost:27017/
MONGO_DSN=mongodb://localhost:27017/tz_bot_db

# ID чата (канала или группы), куда бот будет отправлять готовые ТЗ
# ID должен быть числом (для приватных групп/каналов начинается с -100...)
TARGET_CHAT_ID=-100123456789

# Список ID пользователей (через запятую, без пробелов), которым разрешено пользоваться ботом
ALLOWED_USERS=12345678,98765432

# Username главного креатора для уведомлений об изменениях ТЗ
CREATOR_USERNAME=@supersk
